{
  "name": "agent-bus-spike",
  "version": "0.0.1",
  "description": "Stage-0 spike: the channel server wrapped as a plugin to check scoped names",
  "author": { "name": "Andrew Kolpakov" },
  "mcpServers": {
    "bus": {
      "command": "uv",
      "args": ["run", "--quiet", "--script", "${CLAUDE_PLUGIN_ROOT}/channel_spike.py"]
    }
  },
  "channels": [
    { "server": "bus", "displayName": "agent-bus spike" }
  ]
}
